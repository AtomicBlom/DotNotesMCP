<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IDE0005 (unused usings) only runs at build when the doc file is generated. We want that
         check, not the XML output, so CS1591 stays off. See dotnet/roslyn#41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The version comes from the git tag, so a build carries the release it belongs to rather
         than a number someone remembered to bump. Tags are v-prefixed. A build from an archive
         with no .git falls back to 0.0.0-alpha.0, which is honest about not knowing. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Ships ahead-of-time compiled, so the analyzers that decide whether it can run that way are on
       for every ordinary build. Without this they run only at `publish -r <rid> -p:PublishAot=true`,
       and a reflecting call added on a Tuesday is found by whoever next cuts a release rather than
       by whoever wrote it. Warnings are errors here, so it fails at the keystroke that caused it.

       Not the tests: they run on a JIT and their runner does not claim to be trim-safe. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
